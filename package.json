{
  "name": "mac-terminal",
  "version": "6.2.1",
  "description": "Control the macOS Terminal app",
  "license": "MIT",
  "repository": "github:patrik-csak/mac-terminal",
  "author": "Patrik Csak <p@trikcsak.com> (https://patrikcsak.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./source/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": "22 - 26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22 - 26"
    }
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "prebuild": "rm -fr types",
    "build": "tsc",
    "lint": "eslint && knip",
    "prepack": "node --run build",
    "test": "node --experimental-test-module-mocks --test",
    "test:coverage": "node --run test -- --experimental-test-coverage"
  },
  "files": [
    "source",
    "types"
  ],
  "keywords": [
    "macos",
    "mac",
    "terminal",
    "terminal.app",
    "apple",
    "applescript"
  ],
  "dependencies": {
    "plist": "^5.0.0",
    "run-applescript": "^7.0.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-config-xo": "^7.0.0",
    "knip": "^6.29.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
