{
  "name": "mac-terminal",
  "version": "6.1.0",
  "description": "Control the macOS Terminal app",
  "license": "MIT",
  "repository": "github:patrik-csak/mac-terminal",
  "author": "Patrik Csak <p@trikcsak.com> (https://patrikcsak.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./source/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": "22 - 24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.16 - 12"
    }
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "prebuild": "rm -fr types",
    "build": "tsc",
    "lint:check": "eslint",
    "lint:fix": "eslint --fix",
    "prepack": "npm run build",
    "quality:check": "npm run types:check && npm run lint:check && npm run unused:check",
    "quality:fix": "npm run lint:fix",
    "test": "node --experimental-test-module-mocks --test",
    "test:coverage": "npm run test -- --experimental-test-coverage",
    "types:check": "tsc --noEmit",
    "unused:check": "knip"
  },
  "files": [
    "source",
    "types"
  ],
  "keywords": [
    "macos",
    "mac",
    "terminal",
    "terminal.app",
    "apple",
    "applescript"
  ],
  "dependencies": {
    "plist": "^5.0.0",
    "run-applescript": "^7.0.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-config-xo": "^1.0.0",
    "knip": "^6.29.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
